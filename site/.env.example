# ============================================================
#  스퀘어빌리지 포털 환경변수 — 예시 파일
# ============================================================
#  ★ 이 파일에는 절대 실제 값을 적지 마세요.
#    저장소에 그대로 커밋되고, 저장소가 Public 이면 전부 공개됩니다.
#
#  로컬 개발용 실제 값은 이 파일을 복사해서 만듭니다:
#      cp .env.example .env.local
#    .env.local 은 .gitignore 에 걸려 있어 커밋되지 않습니다.
#
#  배포용 실제 값은 파일이 아니라
#    Vercel → Settings → Environment Variables 에 넣습니다.
#    각 항목의 Type(Secret / Config)은 아래 [ ] 표시를 따르세요.
#    Production / Preview / Development 세 개를 모두 체크하고,
#    다 넣은 뒤 Redeploy 해야 반영됩니다.
# ============================================================


# ── GitHub : 저장소를 데이터베이스로 사용 ──────────────────
# 이 두 개가 없으면 배포된 사이트가 빈 화면이 됩니다.
# (로컬에서만 저장소 대신 루트의 data.json 을 읽습니다)

# [Secret] Fine-grained PAT
#   GitHub → Settings → Developer settings → Personal access tokens
#            → Fine-grained tokens → Generate new token
#   Repository access : 이 저장소 하나만
#   Permissions       : Repository → Contents: Read and write  (이것만)
GITHUB_TOKEN=github_pat_여기에_붙여넣기

# [Config] 포털 저장소 — 계정/저장소 형식. https:// 나 .git 은 붙이지 않습니다
GITHUB_REPO=계정/저장소

# [Config] 기본 브랜치
GITHUB_BRANCH=main


# ── 런처 ────────────────────────────────────────────────────
# [Config] 런처 릴리스가 올라가는 저장소.
#   사이트의 「런처 받기」 버튼이 이 저장소의 releases/latest 로 연결됩니다.
#   ★ Public 이어야 합니다. Private 이면 방문자에게 404 로 보입니다.
LAUNCHER_REPO=계정/저장소


# ── 디스코드 : 게시판 콘텐츠 동기화 ─────────────────────────
# 아래 세 개가 없으면 사이트는 정상 동작하고 동기화만 멈춥니다.

# [Secret] 봇 토큰
#   Discord Developer Portal → 애플리케이션 → Bot → Reset Token
#   ★★ Bot 화면의 Privileged Gateway Intents 에서
#      MESSAGE CONTENT INTENT 를 반드시 켜세요.
#      안 켜면 본문과 첨부가 빈 채로 들어옵니다 (제목·작성자만 보임).
#   ★ 필요한 권한:
#       View Channel            (읽기)
#       Read Message History    (읽기)
#       Send Messages           (웹 글 → 텍스트 채널)
#       Create Public Threads   (웹 글 → 포럼 채널 게시물 생성)
#       Send Messages in Threads(웹 댓글 → 포럼 스레드)
#     URL Generator 로 만들면 permissions=309237713920 이 됩니다.
DISCORD_BOT_TOKEN=봇_토큰

# [Config] 게시판slug:채널ID 를 콤마로 이어 붙입니다.
#   채널 ID : 디스코드 설정 → 고급 → 개발자 모드 ON → 채널 우클릭 → ID 복사
#   ★ 텍스트 채널과 포럼 채널 모두 됩니다. 종류는 자동으로 판별합니다.
#     포럼은 게시물(스레드) 하나가 글 하나이고, 스레드 이름이 제목이 됩니다.
#     포럼을 쓰면 DISCORD_GUILD_ID 도 채워야 진행 중인 게시물을 읽을 수 있습니다.
#   있는 채널만 넣으면 됩니다. 매핑하지 않은 게시판은 비어 있을 뿐 오류는 없습니다.
#   사용 가능한 slug (site/lib/boards.js 참고):
#     소식   : notice update event patch maintenance
#     커뮤니티 : free qna tip shot guild friend fanart suggest
DISCORD_CHANNELS=notice:000000000000000000,update:000000000000000000,free:000000000000000000

# [Config, 선택] 채널을 '처음' 연결할 때 가져올 과거 글 수 (1~100, 기본 10).
#   이미 글이 쌓인 채널을 엮을 때만 올리세요. 한 번 수집한 뒤에는 의미가 없습니다.
#   ★ 이미지는 한 번 돌 때 20장까지만 가져오므로, 큰 값으로 첫 수집을 하면
#     뒤쪽 글의 이미지는 빠집니다.
SYNC_FIRST_RUN=10

# [Secret] 동기화 엔드포인트 보호용 공유 비밀값.
#   아무 긴 랜덤 문자열. 아래 명령으로 만들 수 있습니다:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   ★ 같은 값을 GitHub 저장소 → Settings → Secrets and variables → Actions 의
#     SYNC_SECRET 에도 넣어야 5분마다 동기화가 돕니다 (SITE_URL 도 함께).
SYNC_SECRET=긴_랜덤_문자열

# [Secret, 선택] Vercel Cron(하루 1회 예비)을 쓸 경우 Vercel 이 붙여주는 값
CRON_SECRET=


# ── 디스코드 로그인 (OAuth2) ────────────────────────────────
# 스퀘어빌리지 디스코드 멤버만 로그인할 수 있습니다.
# 로그인하면 게시판 글쓰기·댓글이 열리고, 운영진 역할이면 /admin 이 열립니다.
# 아래 다섯 개가 모두 채워져야 로그인 버튼이 활성화됩니다.

# [Config] Developer Portal → 애플리케이션 → OAuth2 → Client ID
DISCORD_CLIENT_ID=

# [Secret] 같은 화면의 Client Secret (Reset 하면 새로 발급됩니다)
DISCORD_CLIENT_SECRET=

# ★ 같은 화면 Redirects 에 아래 주소를 반드시 등록하세요.
#     https://<배포주소>/api/auth/callback
#   등록하지 않으면 invalid_redirect_uri 로 실패합니다.

# [Config] 스퀘어빌리지 디스코드 서버 ID
#   서버 이름 우클릭 → 서버 ID 복사 (개발자 모드 ON 필요)
DISCORD_GUILD_ID=

# [Config] 운영진으로 인정할 역할 ID (콤마로 여러 개)
#   서버 설정 → 역할 → 역할 우클릭 → ID 복사
#   비워 두면 아무도 /admin 에 들어갈 수 없습니다.
DISCORD_STAFF_ROLES=

# [Secret] 세션 쿠키 서명 키. 아무 긴 랜덤 문자열.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   ★ 이 값을 바꾸면 모든 사람이 로그아웃됩니다.
AUTH_SECRET=

# [Config] 배포 주소. OAuth 리다이렉트에 씁니다.
#   비워 두면 요청 헤더로 유추하지만, 커스텀 도메인이 있으면 명시하는 게 안전합니다.
SITE_URL=

# [Config, 선택] 웹에서 쓴 글·댓글을 디스코드로 보낼지. 0 이면 끕니다 (기본 켜짐)
DISCORD_MIRROR=1
