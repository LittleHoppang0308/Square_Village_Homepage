# ── GitHub (저장소를 DB로 사용) ─────────────────────────────
# fine-grained PAT, 대상 저장소에 Contents: Read and write 권한만
GITHUB_TOKEN=github_pat_xxxxxxxx
GITHUB_REPO=LittleHoppang0308/squarevillage-portal
GITHUB_BRANCH=main

# ── 디스코드 ────────────────────────────────────────────────
# 봇 권한: View Channel + Read Message History (전송 권한 불필요)
DISCORD_BOT_TOKEN=xxxxxxxx
# 게시판slug:채널ID 를 콤마로. 매핑하지 않은 게시판은 동기화되지 않는다
DISCORD_CHANNELS=notice:000000000000000000,update:000000000000000000,event:000000000000000000,free:000000000000000000,qna:000000000000000000,tip:000000000000000000,shot:000000000000000000,guild:000000000000000000,suggest:000000000000000000

# ── 동기화 트리거 ───────────────────────────────────────────
# GitHub Actions가 /api/sync/discord 를 호출할 때 쓰는 공유 비밀값
SYNC_SECRET=아무_긴_랜덤_문자열
# Vercel Cron 을 쓸 경우 Vercel이 붙여주는 값 (선택)
CRON_SECRET=

# ── 런처 ────────────────────────────────────────────────────
LAUNCHER_REPO=LittleHoppang0308/squarevillage-launcher
